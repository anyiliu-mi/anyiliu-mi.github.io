---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import RecentNews from '../components/RecentNews.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
---

<BaseLayout title="Anyi Liu - Security & AI Research">
  <!-- About Me -->
  <section class="section">
    <SectionHeader title="About Me" href="#" linkText="" />
    <div class="bio">
      <p>
        I am an Associate Professor in the Department of Computer Science and Engineering at <a href="https://www.oakland.edu/" target="_blank" rel="noopener noreferrer">Oakland University</a>. I received my Ph.D. degree from the Department of Computer Science at <a href="https://www.gmu.edu/" target="_blank" rel="noopener noreferrer">George Mason University</a>.
      </p>
      <p>
        My research lies at the intersection of systems security, software engineering, and artificial intelligence. I am particularly interested in how we can build systems that remain secure and reliable even as they incorporate probabilistic AI components.
      </p>

      <h3>Research Interests</h3>
      <ul>
        <li><strong>AI Security:</strong> Physical AI Security. Robust Agentic Systems.</li>
        <li><strong>System Security:</strong> Cloud, Mobile, and IoT/CPS Security, Hardware-assisted Execution Environments.</li>
        <li><strong>Forensics:</strong> Digital Forensics, Intrusion Detection, Prevention, and Correlation.</li>
      </ul>
    </div>
  </section>

  <!-- Recent News Ticker -->
  <section class="section news-section">
    <SectionHeader title="Recent News" href="#" linkText="" />
    <RecentNews />
  </section>

  <section class="section">
    <SectionHeader title="Selected Sponsored Projects" href="/research/projects" linkText="View all projects" />
    <ProjectGrid>
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          summary={project.data.summary}
          year={project.data.year}
          category={project.data.category}
          slug={project.slug}
          tags={project.data.tags}
        />
      ))}
    </ProjectGrid>
  </section>

  <section class="section" style="display: flex; flex-direction: column; align-items: center; gap: 1.5rem; margin-top: 1.5rem;">
    <!-- Map Widget -->
    <script type="text/javascript" id="mapmyvisitors" src="//mapmyvisitors.com/map.js?d=wEGmg-lIGopAIXX7Y0GZ48LXfpHDxLZMrEQ--w4yprk&cl=ffffff&w=a"></script>
    
    <!-- Globe Widget -->
    <script type="text/javascript" id="mmvst_globe" src="//mapmyvisitors.com/globe.js?d=5Be599d8xtIbrM8ByaeLuoDSemB4L9yFm7ZvJc3P9Yk"></script>
  </section>
</BaseLayout>

<style>
  .section {
    margin-bottom: var(--space-8);
  }
  
  .bio {
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .bio a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
  }

  .bio a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .bio h3 {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-1);
  }

  .bio ul {
    list-style: disc outside;
    margin-left: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .bio li {
    margin-bottom: var(--space-2);
    line-height: 1.45;
  }
</style>
